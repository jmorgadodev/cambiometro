{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cambiometro-public-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "transparencia-db",
      "database_id": "3731487c-ed6b-401e-a33d-7ecf15bfd229"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PUBLIC_DATA",
      "bucket_name": "transparencia-public-data"
    }
  ],
  "ratelimits": [
    {
      "name": "EXPENSIVE_API_RATE_LIMITER",
      "namespace_id": "47011",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
