{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cambiometro-public-api",
  "main": "index.ts",
  "migrations_dir": "../../migrations",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "workers_dev": false,
  "routes": [
    { "pattern": "cambiometro.impulsacv.cl/api/*", "zone_name": "impulsacv.cl" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "transparencia-db",
      "database_id": "3731487c-ed6b-401e-a33d-7ecf15bfd229"
    }
  ],
  "r2_buckets": [
    { "binding": "PUBLIC_DATA", "bucket_name": "transparencia-public-data" }
  ],
  "ratelimits": [
    { "name": "EXPENSIVE_API_RATE_LIMITER", "namespace_id": "47011", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "cambiometro-staging",
      "workers_dev": true,
      "routes": [],
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "transparencia-db-staging-LOCAL",
          "database_id": "00000000-0000-0000-0000-000000000000"
        }
      ],
      "r2_buckets": [
        { "binding": "PUBLIC_DATA", "bucket_name": "transparencia-public-data" }
      ],
      "ratelimits": [
        { "name": "EXPENSIVE_API_RATE_LIMITER", "namespace_id": "47012", "simple": { "limit": 30, "period": 60 } }
      ]
    }
  }
}
