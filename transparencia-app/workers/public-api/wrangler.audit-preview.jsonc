{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cambiometro-public-api-r2-audit-preview",
  "main": "index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "READ_ONLY_PREVIEW": "1",
    "ALLOW_PUBLIC_D1_READS": "0",
    "PREFER_TRANSFER_D1": "0",
  },
  "routes": [],
  "r2_buckets": [
    { "binding": "PUBLIC_DATA", "bucket_name": "transparencia-public-data" },
  ],
  "observability": { "enabled": true },
}
