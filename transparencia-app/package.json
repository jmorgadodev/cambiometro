{
  "name": "transparencia-app",
  "version": "0.1.0",
  "description": "Plataforma ciudadana de datos públicos de Chile — Transparencia, Vínculos y Finanzas Públicas",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build:slices": "node scripts/build-politico-slices.mjs",
    "build": "node scripts/build-politico-slices.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/check-no-hardcoded-colors.mjs",
    "check:links": "node scripts/check-safe-links.mjs",
    "check:innerhtml": "node scripts/check-no-innerhtml.mjs",
    "test:coverage-sweep": "node scripts/coverage-sweep.mjs",
    "test": "node scripts/build-politico-slices.mjs && npm run typecheck && npm run check:tokens && npm run check:links && npm run check:innerhtml && npm run test:coverage-sweep && npm run test:etl && vitest run",
    "test:etl": "node --test scripts/etl/*.test.mjs",
    "guard:integrity": "node ../scripts/audit/pipeline-guard.mjs",
    "preflight": "npm run lint && npm run test && npm run cf:build",
    "verify:browser": "node scripts/verify-integration.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "check:bundle": "node scripts/audit/measure-bundle-size.mjs",
    "smoke:uptime": "node scripts/uptime-smoke.mjs",
    "cf:build": "opennextjs-cloudflare build",
  "pages:build": "node scripts/build-politico-slices.mjs && node scripts/build-transferencias-static.mjs && node scripts/build-funcionarios-static.mjs && node scripts/build-pages-static.mjs",
  "data:build:funcionarios-static": "node scripts/build-funcionarios-static.mjs",
  "data:hydrate:cplt": "node scripts/hydrate-cplt-from-r2.mjs",
    "pages:verify": "node scripts/verify-pages-static.mjs && node scripts/verify-pages-route-links.mjs",
    "verify:pages-browser": "node scripts/verify-pages-browser.mjs",
    "pages:crawl": "node scripts/verify-pages-crawl.mjs",
    "pages:rollback": "node scripts/pages-rollback.mjs",
    "worker:check": "tsc --noEmit -p workers/public-api/tsconfig.json",
    "worker:test": "vitest run workers/public-api/src/index.test.ts",
    "worker:bundle": "node scripts/audit/verify-worker-bundle.mjs",
    "audit:repo-boundary": "node scripts/audit/verify-repository-boundary.mjs",
    "preview": "opennextjs-cloudflare build && mkdir .open-next\\assets || echo 0 && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "etl": "node scripts/etl.mjs",
    "etl:votaciones": "node scripts/ingest-votaciones-full.mjs",
    "etl:prepare": "node scripts/prepare-etl-workspace.mjs",
    "data:lake": "node scripts/build-data-lake.mjs",
    "data:lake:dry": "node scripts/build-data-lake.mjs --dry-run",
    "data:lake:projection:infoprobidad": "node scripts/build-infoprobidad-v1.mjs",
    "data:lake:projection:presupuesto": "node scripts/build-presupuesto-v1.mjs",
    "data:lake:projection:chilecompra": "node scripts/build-chilecompra-v1.mjs",
    "data:lake:projection:sinim": "node scripts/build-sinim-v1.mjs",
    "data:lake:projection:servel": "node scripts/build-servel-v1.mjs",
    "data:lake:projection:infolobby": "node scripts/build-infolobby-v1.mjs",
    "data:lake:projection:ley19862": "node scripts/build-ley19862-v1.mjs",
    "data:publish": "node scripts/publish-data-lake.mjs --releases --r2",
    "data:materialize": "node scripts/materialize-d1.mjs",
    "data:materialize:dry": "node scripts/materialize-d1.mjs --dry-run",
    "data:catalog:reconcile": "node scripts/reconcile-release-catalog.mjs",
    "data:publish:cplt": "node scripts/publish-cplt-projections.mjs --releases --r2",
    "data:local:cplt": "node scripts/publish-cplt-projections.mjs --local-only",
    "data:publish:cplt-category": "node scripts/stage-cplt-category.mjs",
    "data:finalize:cplt": "node scripts/merge-cplt-category-artifacts.mjs && node scripts/publish-cplt-projections.mjs --releases --r2 && node scripts/record-cplt-source-state.mjs --remote",
    "data:record:cplt": "node scripts/record-cplt-source-state.mjs",
    "data:inventory": "node scripts/inventory-sources.mjs",
    "data:health": "node scripts/build-source-health.mjs",
    "data:verify:coherence": "node scripts/verify-pinned-data-coherence.mjs",
    "data:verify:full:ley19862": "node scripts/verify-full-transfer-source.mjs",
    "data:communes:update": "node scripts/update-commune-catalog.mjs",
    "data:communes:check": "node scripts/update-commune-catalog.mjs --check",
    "ingest:dipres": "node scripts/ingest-dipres.mjs",
    "ingest:chilecompra": "node scripts/ingest-chilecompra.mjs",
    "ingest:sinim": "node scripts/ingest-sinim.mjs",
    "ingest:ley-19862": "node scripts/ingest-ley-19862.mjs",
    "data:backfill:ley19862": "node scripts/backfill-ley-19862-full.mjs",
    "data:verify:r2:ley19862": "node scripts/verify-r2-ley19862-release.mjs",
    "ingest:contraloria": "node scripts/ingest-contraloria.mjs",
    "ingest:senado": "node scripts/ingest-senado.mjs",
    "ingest:servel": "node scripts/ingest-servel.mjs",
    "ingest:camara-attendance": "node scripts/ingest-camara-attendance.mjs",
    "ingest:infolobby": "node scripts/ingest-infolobby.mjs",
    "ingest:infoprobidad": "node scripts/ingest-infoprobidad.mjs",
    "etl:personal-apoyo": "node scripts/etl-personal-apoyo.mjs",
    "poll:personal-apoyo": "node scripts/poll-camara-personal-apoyo.mjs",
    "data:publish:personal-apoyo": "node scripts/publish-personal-apoyo.mjs",
    "ingest:cplt-personal": "node --max-old-space-size=4096 scripts/etl/stream-remote-personal.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/cytoscape": "^3.21.9",
    "csv-parser": "^3.2.1",
    "cytoscape": "^3.34.0",
    "echarts": "^6.1.0",
    "fflate": "0.8.3",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "iconv-lite": "^0.7.3",
    "minisearch": "^7.2.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "satori": "^0.29.0",
    "saxes": "6.0.0",
    "server-only": "^0.0.1",
    "wrangler": "^4.119.0"
  },
  "devDependencies": {
    "@e965/xlsx": "0.20.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "puppeteer-core": "^25.7.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
