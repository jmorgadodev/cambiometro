{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cambiometro",
  "main": ".open-next/worker.js",
  "minify": true,
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "PUBLIC_DATA",
      "bucket_name": "transparencia-public-data"
    }
  ],
  "routes": [
    {
      "pattern": "cambiometro.impulsacv.cl",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "EXPENSIVE_API_RATE_LIMITER",
      "namespace_id": "47011",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "transparencia-db",
      "database_id": "3731487c-ed6b-401e-a33d-7ecf15bfd229"
    }
  ],
  "env": {
    "staging": {
      "name": "cambiometro-staging",
      "workers_dev": true,
      "routes": [],
      "observability": {
        "enabled": true
      },
      "ratelimits": [
        {
          "name": "EXPENSIVE_API_RATE_LIMITER",
          "namespace_id": "47012",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "r2_buckets": [
        {
          "binding": "PUBLIC_DATA",
          "bucket_name": "transparencia-public-data"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "transparencia-db",
          "database_id": "3731487c-ed6b-401e-a33d-7ecf15bfd229"
        }
      ]
    }
  }
}
